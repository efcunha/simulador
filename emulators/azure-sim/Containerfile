# azure-sim OCI image (Podman) — design §6.1.
#
# Build context = the WORKTREE ROOT (the dir containing both tools/ and
# services/), NOT emulators/azure-sim. The Phase 1 generator is imported as the
# namespace path ``tools.synthetic_clouds.*`` resolved via PYTHONPATH — never a
# wheel install (design §2/§6.1) — so the image bakes both trees under /app and
# sets PYTHONPATH=/app. Build from the worktree root with:
#   podman build -f emulators/azure-sim/Containerfile -t azure-sim .
#
# Multi-stage: a builder stage installs ONLY azure-sim's own third-party deps
# into a venv (NOT FinOps-synthetic-clouds); the runtime stage copies the
# venv + source and runs as a non-root user. Default CMD serves the API;
# ``python -m azure_sim export ...`` runs the exporter (via podman exec).

# ---- builder ---------------------------------------------------------------
FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Third-party deps ONLY (design §2/§6.1). FinOps-synthetic-clouds is NOT a
# dependency — tools.synthetic_clouds resolves via PYTHONPATH at runtime, not an
# index install. Mirrors emulators/azure-sim/pyproject.toml [project.dependencies]
# plus pandas, which the Phase 1 renderer needs at runtime.
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install \
    "fastapi" \
    "uvicorn" \
    "azure-storage-blob" \
    "pyarrow" \
    "pandas"

# ---- runtime ---------------------------------------------------------------
FROM python:3.12-slim AS runtime

# Non-root user (design §6.1): the sim never needs root; blob writes go over the
# network to Azurite and the estate is baked in at build time.
RUN useradd --create-home --uid 10001 azuresim

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

# Bake both trees in. The build context is the worktree root, so these paths are
# relative to it. tools.synthetic_clouds resolves via PYTHONPATH=/app.
COPY tools/synthetic_clouds /app/tools/synthetic_clouds
COPY specs /app/specs
COPY emulators/azure-sim /app/emulators/azure-sim

# azure_sim lives at emulators/azure-sim/azure_sim; tools at /app/tools. Both are
# importable with /app and /app/emulators/azure-sim on PYTHONPATH.
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app:/app/emulators/azure-sim" \
    PYTHONUNBUFFERED=1 \
    API_PORT=8080

USER azuresim

EXPOSE 8080

# Liveness probe hits GET /healthz on the API (design §6.1). Uses stdlib urllib
# so no extra tool (curl/wget) is required in the slim image.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import os,urllib.request,sys; p=os.environ.get('API_PORT','8080'); sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{p}/healthz', timeout=3).status==200 else 1)"]

# Default: serve the control-plane API. Export runs as ``python -m azure_sim
# export ...`` via podman exec (scripts/synthetic-clouds/export_once.ps1).
CMD ["python", "-m", "azure_sim", "serve", "--host", "0.0.0.0", "--port", "8080"]
