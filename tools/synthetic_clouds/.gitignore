# Generated run artifacts (canonical Parquet + rendered CSV/Parquet/JSON/DDL).
# These are reproducible from `python -m tools.synthetic_clouds` and must not be
# committed. The committed artifact is docs/synthetic-clouds/scenarios.json only.
out/

# Scheduler: generated by `schedule install`, rewritten by every install, and
# machine-specific (absolute paths). `schedule/config.json` is NOT ignored: it is
# the configuration of record -- hora, fuso, seed, profile.
schedule/run-daily.cmd
schedule/*.xml

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.pyc
