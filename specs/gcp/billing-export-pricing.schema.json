    { "name": "geo_taxonomy.regions", "type": "Array of Strings", "required": false, "unit": null, "beta": true, "null_when": "geo_taxonomy.type = GLOBAL", "source_url": "https://docs.cloud.google.com/billing/docs/how-to/export-data-bigquery-tables/pricing-data#geo_taxonomy-regions", "status": "verified" },
