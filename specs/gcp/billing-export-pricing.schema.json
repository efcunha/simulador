    "clustering_status": "unverified",
    "clustering_note": "No official page consulted declares clustering columns for cloud_pricing_export.",
    "dataset_location": "user-selected; same Cloud Billing export dataset location rules",
    "load_frequency": "once each day (first load can take up to 48 hours)",
    "retroactive_backfill": false,
    "retroactive_backfill_note": "Pricing data is only present from the date the pricing export was enabled; it is not added retroactively.",
    "row_granularity": "One row per SKU per pricing tier per pricing_as_of_time day (each pricing tier of a multi-tier SKU appears as a different row).",
    "created_by": "Cloud Billing export to BigQuery (automatic table creation after enabling the export)"
  },
  "join_to_usage_cost_data": {
    "documented_by": "official query example",
    "documented_section": "Join pricing data with detailed usage cost data",
    "source_url": "https://docs.cloud.google.com/billing/docs/how-to/bq-examples",
    "usage_cost_side_table": "gcp_billing_export_resource_v1_<BILLING_ACCOUNT_ID>",
    "pricing_side_table": "cloud_pricing_export",
    "keys": [
      { "usage_cost_column": "sku.id", "pricing_column": "sku.id", "operator": "=" },
      { "usage_cost_column": "price.tier_start_amount", "pricing_column": "start_usage_amount (inside list_price.tiered_rates, after CROSS JOIN UNNEST)", "operator": "=" }
    ],
    "filters_in_example": [
      "DATE(Exports.export_time) = '2023-06-30'",
      "DATE(FlattenedPrices.export_time) = '2023-06-30'",
      "cost > 0"
    ],
    "currency_join_condition": null,
    "currency_join_note": "The docs define no currency-column equality join. The two tables relate currencies by the documented conversion formula, not by an equality predicate.",
