    "partitioning": "_PARTITIONTIME",
    "partitioning_status": "verified-as-stated-in-docs",
    "partitioning_statement": "_PARTITIONTIME is a field auto-generated by BigQuery and represents the date that the data belongs to. All official query examples for this table filter with WHERE DATE(_PARTITIONTIME) = \"2020-07-20\". The docs state you can equivalently filter on the Cloud Billing generated field pricing_as_of_time: WHERE DATE(pricing_as_of_time) = \"2020-07-20\".",
    "partitioning_granularity": "day (only implied by DATE(...) in the documented examples; the docs do not write the words 'day partition')",
    "partitioning_granularity_status": "unverified-as-text",
    "partitioning_source_url": "https://docs.cloud.google.com/billing/docs/how-to/export-data-bigquery-tables/pricing-data",
