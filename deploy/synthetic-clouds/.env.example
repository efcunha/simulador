# synthetic-clouds stack configuration (Azure + GCP + AWS).
#
# Copy to `.env` in this directory and adjust. `podman compose` reads `.env`
# automatically. Every variable below is optional; the defaults shown produce a
# working small-profile stack. Azure keys drive the azure-sim stack
# (compose.yaml); GCP keys drive the gcp-sim stack (compose.gcp.yaml).
#
#   cp .env.example .env

# ===========================================================================
# AZURE (azure-sim + azurite) — compose.yaml
# ===========================================================================

# ---------------------------------------------------------------------------
# Simulator settings — read by emulators/azure-sim/azure_sim/config.py.
# Each is validated at load time; a bad value fails the container closed.
# ---------------------------------------------------------------------------

# Deterministic seed for the canonical estate (any integer).
SEED=42

# Estate size profile: small | medium | large.
PROFILE=small

# Reporting currency: USD | BRL.
CURRENCY=USD

# Billing agreement shape: mca | ea (affects export folder/column layout).
AGREEMENT=mca

# Which exports to emit — non-empty subset of: focus,actual,amortized.
EXPORTS=focus

# File format(s) per export — non-empty subset of: csv,parquet.
# csv is always gzip-wrapped (*.csv.gz) to match the real parser's suffix detect.
FORMAT=csv,parquet

# Export schedule: daily (month-to-date) | monthly (prior month) | one-time (all).
SCHEDULE=one-time

# Hours to shift the manifest export_time to emulate Azure publish lag (>= 0).
LATENCY_HOURS=4

# Row count that triggers partitioning into part_<file>_<NNNN> files (>= 1).
MAX_ROWS_PER_PART=1000000

# Blob container name for exports — charset [A-Za-z0-9-/_].
BLOB_CONTAINER=exports

# Root directory prefix inside the container — charset [A-Za-z0-9-/_].
ROOT_DIRECTORY=cost-exports

# Default HTTP list page size for the control-plane API (>= 1).
API_PAGE_SIZE=1000

# Azurite blob endpoint as seen from INSIDE the compose network. Uses the
# service name `azurite` and the well-known public emulator account (not a
# secret). Override only if you rename the service or account.
AZURE_BLOB_ENDPOINT=http://azurite:10000/devstoreaccount1

# ---------------------------------------------------------------------------
# Host port mapping — read by compose.yaml only (not config.py).
# ---------------------------------------------------------------------------

# Host port that maps to the azure-sim API (container 8080).
API_PORT=8080

# Host port that maps to the Azurite blob endpoint (container 10000).
AZURITE_BLOB_PORT=10000

# ---------------------------------------------------------------------------
# Phase-4 override contract (design §6.3) — DOCUMENTED HERE, NOT WIRED IN PHASE 2.
#
# These are the env vars Phase 4 will thread into the PRODUCTION Azure SDK
# clients so they point at this simulator. azure-sim itself does NOT read them;
# they live here so an operator pointing FinOps backend at the sim knows
# exactly what to set. ALL default to real Azure when unset — leave them unset
# unless you are running the Phase-4 integration against this sim.
#
#   AZURE_MANAGEMENT_ENDPOINT -> CostManagementClient(..., base_url=) and other
#                                management-plane clients. Point at the azure-sim
#                                API base URL (e.g. http://localhost:8080).
#   AZURE_AUTHORITY_HOST      -> ClientSecretCredential(..., authority=). Point at
#                                the azure-sim token endpoint host.
#   AZURE_BLOB_ENDPOINT       -> the blob client that READS the FOCUS export.
#                                Point at the Azurite blob endpoint. (Note: the
#                                sim's own writer reuses this same var name above
#                                for the write side.)
#
# Example Phase-4 overrides (commented — do not enable in Phase 2):
# AZURE_MANAGEMENT_ENDPOINT=http://localhost:8080
# AZURE_AUTHORITY_HOST=http://localhost:8080
# AZURE_BLOB_ENDPOINT=http://localhost:10000/devstoreaccount1
# ---------------------------------------------------------------------------

# ===========================================================================
# GCP (gcp-sim + bigquery-emulator) — compose.gcp.yaml
# ===========================================================================
# All values are synthetic/fictional -- NO real credentials.

# --- gcp-sim (Phase 3) ---
GCP_PROJECT=synthetic
GCP_BQ_REST_PORT=9050
GCP_BQ_GRPC_PORT=9060
GCP_SIM_PORT=8085
# Cloud Monitoring is served over gRPC (monitoring_v3 ships no REST transport in any released
# version), so this is a SEPARATE port from the REST plane above.
GCP_SIM_GRPC_PORT=8087
GCP_BILLING_ACCOUNT_ID=SYNTH-BILLING-0001   # synthetic/fictional placeholder
GCP_BILLING_LOCATION=us
GCP_SEED=123
GCP_PROFILE=small

# --- Phase 4 endpoint overrides (documented here; NOT applied in Phase 3) ---
# Default unset = real GCP (behavior-preserving). Phase 4 threads these into
# GCPClient.bigquery_client() (api_endpoint + AnonymousCredentials) and the
# SCC/Recommender clients (transport="rest"). See deploy/synthetic-clouds/README.md.
# GCP_BIGQUERY_API_ENDPOINT=http://localhost:9050
# GCP_SCC_API_ENDPOINT=http://localhost:8085
# GCP_RECOMMENDER_API_ENDPOINT=http://localhost:8085
# GCP_SIM_BASE_URL=http://localhost:8085
# Cloud Monitoring is gRPC, not HTTP: the value is a host:port the GAPIC channel targets.
# GCP_MONITORING_API_ENDPOINT=localhost:8087

# ── AWS side (Phase 6, Item 6) — synthetic S3 plane, local/dev ONLY ───────────────
# MinIO is NOT obtainable (compose.aws.yaml's header records the measured `podman pull`
# denials), so the S3 store is `docker.io/adobe/s3mock`. It ignores credentials, so
# these two values are inert; they stay env-driven because the S3 client still requires
# them. They are synthetic and never leave the compose network. NEVER set real AWS
# credentials in this stack: aws-sim refuses to start when it detects them
# (emulators/aws-sim/aws_sim/guard.py, FR-15).
S3_ACCESS_KEY=synth
S3_SECRET_KEY=synth
S3_PORT=9090
# Bucket the FOCUS 1.2 daily export tree is uploaded to. Matches
# scripts/aws/focus12-full-export.json's export name, and the name aws-sim serves the
# tree's objects under.
AWS_SIM_BUCKET=synthetic-focus12-daily-full
# Directory whose contents ARE that bucket's objects — the uploader's own source
# directory, so a path under it is a key verbatim. aws-sim serves the S3 REST surface
# itself, on the single AWS_SERVICE_ENDPOINT, because boto3 has no per-service endpoint
# and would otherwise never reach s3mock (emulators/aws-sim/aws_sim/api/s3.py).
# UNSET (the default) = the S3 routes answer the estate's bucket list with every object
# listing empty. Local/dev only.
# AWS_SIM_S3_STORE_DIR=/render/aws_focus
AWS_SIM_PORT=8086
AWS_SIM_SEED=123
AWS_SIM_PROFILE=small
AWS_SIM_REGION=us-east-1